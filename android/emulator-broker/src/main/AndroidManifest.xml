<manifest xmlns:android="http://schemas.android.com/apk/res/android" android:sharedUserId="android.uid.system">
    <permission android:name="com.virtualcamerapro.permission.CONTROL" android:protectionLevel="signature|knownSigner" android:knownCerts="@array/controller_certs" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.CAMERA" />
    <application android:label="Virtual Camera Android Emulator Service" android:allowBackup="false" android:networkSecurityConfig="@xml/network_security_config">
        <service android:name=".BrokerService" android:exported="true" android:permission="com.virtualcamerapro.permission.CONTROL" android:foregroundServiceType="specialUse|camera">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Control the selected media source of the Android Emulator environment camera" />
        </service>
    </application>
</manifest>
